# Deployment environment. "production" refuses to start without JWT_SECRET_KEY.
ENVIRONMENT=development

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=25
OPENAI_MAX_TOKENS=2000

# Authentication (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=change-me
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DATABASE=resume_diff_ai

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10 MB in bytes
MAX_TEXT_LENGTH=100000

# CORS / frontend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Email: "console" logs messages, "ses" sends through Amazon SES
EMAIL_BACKEND=console
EMAIL_FROM=Resume Diff AI <no-reply@yourdomain.com>
REQUIRE_EMAIL_VERIFICATION=false

# Google sign-in (OAuth client id from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Stripe (create Products/Prices in the dashboard, then paste the price ids)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PASS=
STRIPE_PRICE_COACH_MONTHLY=

# Privacy: how long saved comparisons are kept
HISTORY_RETENTION_DAYS=365

# Logging / server
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
